# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed variables.

# Leave EMPTY in development — vite.config.ts proxies /api to localhost:8080,
# which keeps the browser same-origin and the session cookie simple.
# Set it only when the API is served from a different origin, no trailing slash.
VITE_API_BASE_URL=

# Cloudflare Turnstile SITE key (public — the secret lives in dashboard-api).
# Empty in development: the API skips the captcha check when it has no secret.
VITE_TURNSTILE_SITE_KEY=
